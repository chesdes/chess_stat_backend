REDIS_HOST=redis
MAX_GAMES=300
MAX_PAGE_SIZE=50
MAX_PGN_LENGTH=200000
MAX_ANALYSIS_RESULTS=5000
ANALYSIS_CONCURRENCY=10
CORS_ORIGINS=*
STATS_RETENTION_DAYS=400

POSTGRES_USER=chess_stat

# openssl rand -hex 16
POSTGRES_PASSWORD=your_secure_postgres_password_here 

# postgresql+asyncpg://<USER>:<PASS>@db:5432/<DB_NAME>
DATABASE_URL=postgresql+asyncpg://chess_stat:your_secure_postgres_password_here@db:5432/chess_stat
POSTGRES_DB=chess_stat

# openssl rand -hex 16
ADMIN_PASSWORD=your_secure_admin_password_here

# openssl rand -hex 32
ADMIN_SECRET=your_secure_admin_secret_hex_here

# openssl rand -hex 32
STATS_IP_SALT=your_secure_stats_ip_salt_hex_here
